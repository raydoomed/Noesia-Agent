# Noesia 的密钥模板。用法：把这份文件复制成引擎家目录里的 .env
#
#   copy .env.example data\NoesiaHome\.env          （Windows cmd）
#   cp .env.example data/NoesiaHome/.env            （bash / PowerShell 的 cp 别名）
#
# 也可以完全不管这个文件：在聊天窗点「设置模型…」→ 选供应商 → 粘贴密钥 → 保存，引擎自己写 .env。
# 只填你真要用的一家，其余留空（空值等于没配）。变量名必须一字不差，改名字引擎就不认。

# ---- 国内常用 ----
# DeepSeek
DEEPSEEK_API_KEY=
# MiniMax（国际站 / 国内站是两套域名，key 不通用，按你注册的站填一个）
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
# 小米 MiMo
XIAOMI_API_KEY=
# 阶跃星辰
STEPFUN_API_KEY=

# ---- 聚合平台（一个 key 转很多家模型，按量计费）----
OPENROUTER_API_KEY=

# ---- 界面里填的（聊天窗「设置模型…」→ 语音模型 / 语音互动）----
# 这三把也能在界面里粘：保存时会先校验，通过才写进这个文件，不用手改。
# ElevenLabs（语音朗读，按字符计费）
ELEVENLABS_API_KEY=
# 豆包语音（火山引擎 TTS）
DOUBAO_API_KEY=
# Vidu 组件版数字人（语音互动那一档，1 积分/秒）
VIDU_TOKEN=

# ---- 记录与排查的开关（默认就是上面这套行为，一般不用改）----
# 会话记录：默认【开】。<家目录>/sessions/<会话id>.json，一个会话一个文件，每轮覆盖成最新，
# 打开就是这段对话的完整记录（角色、内容、工具、时间）。只写本地文件，不花 token。
# 关掉：去掉下一行前面的 # 并写成 0；改完重启引擎生效。
# NOESIA_SESSION_TRANSCRIPT=0
# 请求转储：默认【关】。打开后每个请求再存一份现场（request_dump_*.json，密钥已打码），
# 只有排查 4xx 这类怪问题才需要；开了会多出很多文件。
# NOESIA_DUMP_REQUESTS=1
# 转储最多留几份（默认 200，最旧的先删）。
# NOESIA_DUMP_KEEP=200
